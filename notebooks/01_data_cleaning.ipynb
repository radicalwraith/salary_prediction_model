# %%
import pandas as pd
import numpy as np

# Load the dataset
df = pd.read_csv('../data/ai_job_market_insights.csv')

# Preview the first few rows
df.head()


# %%
# Convert column names to snake_case
df.columns = (
    df.columns
    .str.strip()
    .str.lower()
    .str.replace(' ', '_')
)

# Check the updated column names
df.columns


# %%
# Check data types and non-null values
df.info()


# %%
# Preview unique values in categorical fields
for col in ['industry', 'company_size', 'location', 'ai_adoption_level',
            'automation_risk', 'remote_friendly', 'job_growth_projection']:
    print(f"\n{col} →", df[col].unique())


# %%
# One-hot encode nominal columns
df = pd.get_dummies(df, columns=['industry', 'location'], drop_first=True)

# Preview to confirm it worked
df.head()


# %%
# Step 1: Split each skill string into a list
df['required_skills'] = df['required_skills'].str.lower().str.replace(' ', '_')
df['required_skills'] = df['required_skills'].str.split(',')

# Step 2: Get all unique skills across the dataset
all_skills = set(skill for sublist in df['required_skills'] for skill in sublist)

# Step 3: Create a binary column for each skill
for skill in all_skills:
    df[f'skill_{skill}'] = df['required_skills'].apply(lambda skills: int(skill in skills))

# Optional: drop the original column
df.drop(columns='required_skills', inplace=True)

# Preview the new skill columns
df.head()


# %%
# Export cleaned data to CSV
df.to_csv('../data/cleaned_ai_job_data.csv', index=False)


